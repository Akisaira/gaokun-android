From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] media: iris: gen1 解码器的 seek 做成三选一（seek_mode），修"同一会话 STOP 后重新 START 固件断言"（本地，#128 §12，⬜ 待 A/B）

案卷 docs/stage4-findings.md #128 §12–§13。**本地补丁**。

现象（iris-k6 / k7 / k8，2026-09-28）：v4l2_codec2 的 seek（`V4L2Decoder::flush()`：streamoff CAPTURE → streamoff OUTPUT →
streamon OUTPUT → streamon CAPTURE）之后 0 帧，固件 `sys error (type 1, session ff, deadbead)`，
SFR `Err_Fatal - video_decoder_utils.c:3056`，调试队列 `assert_loop(444): FW Assertion - video_decoder_utils.c:3056`。
k8 的 HFI 跟踪：FLUSH_ALL ✓ → **STOP**（750 ms）→ RELEASE_RESOURCES → 15 条 SET_PROPERTY + SET_BUFFERS ×2 →
**LOAD_RESOURCES + START** → 输出端 SET_PROPERTY → SYS_ERROR。venus 同一份固件 192/192：它的 seek 从不 STOP
（`vdec_stop_capture` / `vdec_stop_output` 各一次 FLUSH_ALL，`vdec_start_output` 的 SEEK 分支直接继续，不重发属性）。
另：上游这条重启路径上 `iris_create_internal_buffers()` 不管已有多少都新建 min_count 个，旧的 BIN / SCRATCH_1
从没向固件 RELEASE_BUFFERS 过 ⇒ 固件手里同时挂着两套输入内部缓冲。

0644 模块参数 `qcom_iris.seek_mode`（默认 0 = 上游，A/B 定下来之前不改默认）：
  0  上游：OUTPUT streamoff（在 INPUT_STREAMING、会话已启动时）发 STOP + RELEASE_RESOURCES，streamon 全部重配 + LOAD_RESOURCES + START
  1  学 venus：同一时机只发 FLUSH_ALL、保留 LOAD_RESOURCES，置 inst->seek_resume；之后 streamon OUTPUT 不重发属性 /
     内部缓冲（session_start 因 LOAD_RESOURCES 仍在而跳过），streamon CAPTURE 不重发输出端属性、只重新给 DPB；
     两个队列都回到 STREAMING 时清 seek_resume。没有 streamon 就 close 时，iris_close() 在 m2m 上下文释放之前
     补 STOP + RELEASE_RESOURCES —— 收尾因此变成 FLUSH_ALL ×2 → STOP → RELEASE_RESOURCES → SESSION_END，与 venus 相同。
  2  上游，但 streamon OUTPUT 重配之前先把固件还挂着的输入内部缓冲逐个 RELEASE_BUFFERS 并等回复
     （逐个等，免得晚到的"释放完成"被下一条会话命令的等待当成自己的回复）
只影响解码器；编码器、DRC、drain 路径不动。
---
diff --git a/drivers/media/platform/qcom/iris/iris_buffer.c b/drivers/media/platform/qcom/iris/iris_buffer.c
index 246ad0a..11e5536 100644
--- a/drivers/media/platform/qcom/iris/iris_buffer.c
+++ b/drivers/media/platform/qcom/iris/iris_buffer.c
@@ -810,6 +810,45 @@ static int iris_release_input_internal_buffers(struct iris_inst *inst)
 	return 0;
 }
 
+/*
+ * gaokun3 0066 (seek_mode=2): release, one at a time and waiting for each reply, the input
+ * internal buffers the firmware still holds. Waiting keeps a late RELEASE_BUFFERS done from
+ * completing the next session command's wait. Nothing is queued on the first streamon, so
+ * this only acts on a restart after STOP + RELEASE_RESOURCES.
+ */
+int iris_release_input_internal_buffers_sync(struct iris_inst *inst)
+{
+	const struct iris_firmware_data *firmware_data = inst->core->iris_firmware_data;
+	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
+	struct iris_buffer *buffer, *next;
+	u32 i;
+	int ret;
+
+	if (inst->domain != DECODER)
+		return 0;
+
+	for (i = 0; i < firmware_data->dec_ip_int_buf_tbl_size; i++) {
+		struct iris_buffers *buffers = &inst->buffers[firmware_data->dec_ip_int_buf_tbl[i]];
+
+		list_for_each_entry_safe(buffer, next, &buffers->list, list) {
+			if (buffer->attr & BUF_ATTR_PENDING_RELEASE)
+				continue;
+			if (!(buffer->attr & BUF_ATTR_QUEUED))
+				continue;
+			buffer->attr |= BUF_ATTR_PENDING_RELEASE;
+			reinit_completion(&inst->completion);
+			ret = hfi_ops->session_release_buf(inst, buffer);
+			if (ret)
+				return ret;
+			ret = iris_wait_for_session_response(inst, false);
+			if (ret)
+				return ret;
+		}
+	}
+
+	return 0;
+}
+
 int iris_alloc_and_queue_persist_bufs(struct iris_inst *inst, enum iris_buffer_type buffer_type)
 {
 	struct iris_buffers *buffers = &inst->buffers[buffer_type];
diff --git a/drivers/media/platform/qcom/iris/iris_buffer.h b/drivers/media/platform/qcom/iris/iris_buffer.h
index 75bb767..b7e916a 100644
--- a/drivers/media/platform/qcom/iris/iris_buffer.h
+++ b/drivers/media/platform/qcom/iris/iris_buffer.h
@@ -115,6 +115,7 @@ int iris_queue_internal_deferred_buffers(struct iris_inst *inst, enum iris_buffe
 int iris_destroy_internal_buffer(struct iris_inst *inst, struct iris_buffer *buffer);
 int iris_destroy_all_internal_buffers(struct iris_inst *inst, u32 plane);
 int iris_destroy_dequeued_internal_buffers(struct iris_inst *inst, u32 plane);
+int iris_release_input_internal_buffers_sync(struct iris_inst *inst);
 int iris_alloc_and_queue_persist_bufs(struct iris_inst *inst, enum iris_buffer_type buf_type);
 int iris_alloc_and_queue_input_int_bufs(struct iris_inst *inst);
 int iris_queue_buffer(struct iris_inst *inst, struct iris_buffer *buf);
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
index f00748b..e8eeb83 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
@@ -222,7 +222,31 @@ static int iris_hfi_gen1_session_stop(struct iris_inst *inst, u32 plane)
 				inst->flush_responses_pending++;
 				ret = iris_wait_for_session_response(inst, true);
 			}
+		} else if (READ_ONCE(iris_seek_mode) == 1 && V4L2_TYPE_IS_OUTPUT(plane) &&
+			   inst->state == IRIS_INST_INPUT_STREAMING &&
+			   inst->sub_state & IRIS_INST_SUB_LOAD_RESOURCES) {
+			/*
+			 * gaokun3 0066: OUTPUT streamoff after CAPTURE streamoff (a seek, or the
+			 * first half of a stop): flush and keep the session loaded and started,
+			 * as venus vdec_stop_output() does. The next streamon continues it;
+			 * iris_close() stops it if none comes.
+			 */
+			reinit_completion(&inst->flush_completion);
+
+			flush_pkt.shdr.hdr.size = sizeof(struct hfi_session_flush_pkt);
+			flush_pkt.shdr.hdr.pkt_type = HFI_CMD_SESSION_FLUSH;
+			flush_pkt.shdr.session_id = inst->session_id;
+			flush_pkt.flush_type = HFI_FLUSH_ALL;
+
+			ret = iris_hfi_queue_cmd_write(core, &flush_pkt, flush_pkt.shdr.hdr.size);
+			if (!ret) {
+				inst->flush_responses_pending++;
+				ret = iris_wait_for_session_response(inst, true);
+			}
+			if (!ret)
+				inst->seek_resume = true;
 		} else if (inst->sub_state & IRIS_INST_SUB_LOAD_RESOURCES) {
+			inst->seek_resume = false;
 			reinit_completion(&inst->completion);
 			iris_hfi_gen1_packet_session_cmd(inst, &pkt, HFI_CMD_SESSION_STOP);
 			ret = iris_hfi_queue_cmd_write(core, &pkt, pkt.shdr.hdr.size);
diff --git a/drivers/media/platform/qcom/iris/iris_instance.h b/drivers/media/platform/qcom/iris/iris_instance.h
index 814b608..c157a01 100644
--- a/drivers/media/platform/qcom/iris/iris_instance.h
+++ b/drivers/media/platform/qcom/iris/iris_instance.h
@@ -31,6 +31,12 @@ enum iris_fmt_type_cap {
 	IRIS_FMT_QC10C,
 };
 
+/*
+ * gaokun3 0066: how a decoder seek (v4l2_codec2 flush: CAPTURE then OUTPUT streamoff,
+ * then both streamon) is carried out; see iris_vdec.c.
+ */
+extern unsigned int iris_seek_mode;
+
 /**
  * struct iris_inst - holds per video instance parameters
  *
@@ -116,6 +122,7 @@ struct iris_inst {
 	bool				last_buffer_dequeued;
 	bool				src_change_subscribed;
 	bool				seq_event_seen;
+	bool				seek_resume;
 	u64				last_buf_ns;
 	u32				frame_counter;
 	u32				frame_rate;
diff --git a/drivers/media/platform/qcom/iris/iris_vdec.c b/drivers/media/platform/qcom/iris/iris_vdec.c
index d1dc09f..a977131 100644
--- a/drivers/media/platform/qcom/iris/iris_vdec.c
+++ b/drivers/media/platform/qcom/iris/iris_vdec.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/moduleparam.h>
 #include <media/v4l2-event.h>
 #include <media/v4l2-mem2mem.h>
 
@@ -363,10 +364,35 @@ void iris_vdec_src_change(struct iris_inst *inst)
 	v4l2_event_queue_fh(&inst->fh, &event);
 }
 
+/*
+ * gaokun3 0066 (#128 §12): v4l2_codec2 seeks by streaming off CAPTURE, then OUTPUT, then
+ * streaming both back on. Upstream gen1 turns the OUTPUT streamoff into STOP +
+ * RELEASE_RESOURCES and the streamon into a full reconfiguration plus LOAD_RESOURCES + START
+ * in the same session; the sc8280xp firmware then asserts (video_decoder_utils.c:3056)
+ * as the output properties arrive.
+ *   0  upstream
+ *   1  like venus vdec_stop_output()/vdec_start_output(): flush, keep the session loaded
+ *      and started, and on streamon send neither properties nor internal buffers again
+ *   2  upstream, but first release the input internal buffers the firmware still holds
+ *      (upstream registers a second set on top of them)
+ */
+unsigned int iris_seek_mode;
+module_param_named(seek_mode, iris_seek_mode, uint, 0644);
+MODULE_PARM_DESC(seek_mode, "gaokun3: decoder seek (OUTPUT streamoff after CAPTURE streamoff): 0 upstream STOP + restart, 1 flush and continue like venus, 2 upstream + release stale input internal buffers");
+
 int iris_vdec_streamon_input(struct iris_inst *inst)
 {
 	int ret;
 
+	if (inst->seek_resume) {
+		/* seek_mode=1: the session was only flushed, nothing to set up again */
+		inst->frame_counter = 0;
+		ret = iris_process_streamon_input(inst);
+		if (!ret && inst->state == IRIS_INST_STREAMING)
+			inst->seek_resume = false;
+		return ret;
+	}
+
 	ret = iris_set_properties(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
 	if (ret)
 		return ret;
@@ -377,6 +403,12 @@ int iris_vdec_streamon_input(struct iris_inst *inst)
 
 	iris_get_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
 
+	if (READ_ONCE(iris_seek_mode) == 2) {
+		ret = iris_release_input_internal_buffers_sync(inst);
+		if (ret)
+			return ret;
+	}
+
 	ret = iris_destroy_dequeued_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
 	if (ret)
 		return ret;
@@ -399,9 +431,12 @@ int iris_vdec_streamon_output(struct iris_inst *inst)
 	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
 	int ret;
 
-	ret = hfi_ops->session_set_config_params(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
-	if (ret)
-		return ret;
+	/* seek_mode=1: the output port is configured and running, only the DPBs go back */
+	if (!inst->seek_resume) {
+		ret = hfi_ops->session_set_config_params(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+		if (ret)
+			return ret;
+	}
 
 	iris_get_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
 
@@ -421,6 +456,9 @@ int iris_vdec_streamon_output(struct iris_inst *inst)
 	if (ret)
 		goto error;
 
+	if (inst->state == IRIS_INST_STREAMING)
+		inst->seek_resume = false;
+
 	return ret;
 
 error:
diff --git a/drivers/media/platform/qcom/iris/iris_vidc.c b/drivers/media/platform/qcom/iris/iris_vidc.c
index 477ef19..094a70a 100644
--- a/drivers/media/platform/qcom/iris/iris_vidc.c
+++ b/drivers/media/platform/qcom/iris/iris_vidc.c
@@ -299,6 +299,18 @@ int iris_close(struct file *filp)
 {
 	struct iris_inst *inst = iris_get_inst(filp);
 
+	/*
+	 * gaokun3 0066 (seek_mode=1): a session flushed at OUTPUT streamoff is still
+	 * loaded and started. Stop it like upstream would have (STOP + RELEASE_RESOURCES)
+	 * while the m2m context, which the stop path returns buffers through, still exists.
+	 */
+	if (inst->seek_resume) {
+		mutex_lock(&inst->lock);
+		inst->hfi_session_ops->session_stop(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+		inst->seek_resume = false;
+		mutex_unlock(&inst->lock);
+	}
+
 	v4l2_ctrl_handler_free(&inst->ctrl_handler);
 	v4l2_m2m_ctx_release(inst->m2m_ctx);
 	v4l2_m2m_release(inst->m2m_dev);
