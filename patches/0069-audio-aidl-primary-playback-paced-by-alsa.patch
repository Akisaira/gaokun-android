+::android::status_t StreamAlsa::refinePlaybackPosition(StreamDescriptor::Position* position) {
+    // In standby everything the client handed over has been played out or discarded.
+    if (mAlsaDeviceProxies.empty()) return ::android::OK;
+    // Unlike refinePosition(), do not overwrite the proxy's transfer counter with the client's:
+    // if there is a pipe in between, frames the client has handed over are not in ALSA yet. The
+    // proxy counts what has actually been written since the device was opened, in client order,
+    // so the n-th frame written into ALSA is the n-th frame sent after start() minus the drops.
+    int64_t presented = mLastPlaybackPresented;
+    uint64_t alsaFrames;
+    struct timespec timestamp;
+    if (proxy_get_presentation_position(mAlsaDeviceProxies[0].get(), &alsaFrames, &timestamp) ==
+        0) {
+        presented = mPlaybackFramesAtOpen + mPlaybackFramesDropped +
+                    static_cast<int64_t>(std::min<uint64_t>(
+                            alsaFrames, std::numeric_limits<int64_t>::max() / 2));
+        position->timeNs = audio_utils_ns_from_timespec(&timestamp);
+    }
+    // Otherwise ALSA is not running (not started yet, or in an underrun): nothing new has been
+    // presented, report the last position at the current time.
+    presented = std::clamp(presented, mLastPlaybackPresented, position->frames);
+    mLastPlaybackPresented = presented;
+    position->frames = presented;
+    return ::android::OK;
+}
+
 void StreamAlsa::shutdown() {
     teardownIo();
 }
