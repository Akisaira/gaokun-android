From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] media: iris: DIAG —— 收尾 / 断电全程跟踪 + A/B 开关（【诊断补丁，不进发版内核】）

案卷 docs/stage4-findings.md #128 §8–§9。只在 kernel-apply-patches.sh --with-diag 时打，打在 0065 之上。

来历：iris-k3 / k4 上机，第一次收尾时等固件回复超时（stop 后约 1.03 s），之后固件不再应答任何命令，
断电握手（PC_PREP）永远等不到 PC_READY。iris-k5（2026-09-28）用本补丁定位：根因是 CAPTURE streamoff
发的 HFI_FLUSH_OUTPUT（A/B 8/11 卡死 vs FLUSH_ALL 0/15），修复是 0065。本补丁留着给以后换固件 / 换内核时复查。

跟踪（默认开，pcdbg=1 hfi_trace=1）：每条 HFI 命令 / 消息 + 队列读写位置（只读 DDR）；上半部 / 线程中断计数；
冷启动 / 断电 / 热恢复各一行结果；CTRL_INIT 前后的 CTRL_STATUS 与 ARG3；0xb0088 改写前后；每次 streamoff 的
flush 类型与耗时；PC_PREP 之后多少 us 就绪。
⚠️ hfi_trace 每帧 4 行，一段 30 帧的片子就能冲掉 128 KiB 的内核日志环 —— 抓日志要从 /dev/kmsg 实时落盘。
断电被跳过或等会话回复超时时：dump 三个队列头与 SFR（DDR），并【仅在 core->lock 内且 hw_powered 时】读
CTRL_STATUS / ARG3 / TZ_CPU_STATUS / INTR_STATUS / INTR_MASK / 0xb0088 —— 从不碰 vcodec 块（可能已被硬件模式断电）。

A/B 开关（/sys/module/qcom_iris/parameters/，0644，默认值 = 打了 0065 的行为）：
  upstream_flush   Y = CAPTURE streamoff 回到上游的 HFI_FLUSH_OUTPUT（重现 #128 的卡死）
  fw_debug         SYS_DEBUG_CONFIG 掩码（venus 发 0x18；k5 上 0x18 什么也没吐）
  pc_mode          1 = 先按 venus 顺序关 MVS0 再 PC_PREP，2 = 拒绝断电
  preset_mask / no_arg3 / bus_reset_only / ahb_reset(9dc5f705) / db_rx_req / read_core_pwr
  recover_skips=N  没有实例时连续 N 次跳过断电 ⇒ 关固件（PAS shutdown）并断电，下次 open 冷启动。
                   ⚠️ k5 实测：同一次开机里救回 7 次，第 8 次冷启动失败（CTRL_STATUS 一直是 0，
                   "error booting up iris firmware"），之后每次 open 都一样 ⇒ 只能当临时止血，不是修复。
---
diff --git a/drivers/media/platform/qcom/iris/iris_core.c b/drivers/media/platform/qcom/iris/iris_core.c
index 8c335db..c55a6b2 100644
--- a/drivers/media/platform/qcom/iris/iris_core.c
+++ b/drivers/media/platform/qcom/iris/iris_core.c
@@ -92,7 +92,13 @@ int iris_core_init(struct iris_core *core)
 
 	mutex_unlock(&core->lock);
 
-	return iris_wait_for_system_response(core);
+	ret = iris_wait_for_system_response(core);
+	if (iris_pcdbg)
+		dev_info(core->dev, "pcdbg: cold boot: SYS_INIT %s (%d)\n", ret ? "FAILED" : "done", ret);
+	if (ret)
+		iris_dbg_dump(core, "sys init");
+
+	return ret;
 
 error_unload_fw:
 	iris_fw_unload(core);
diff --git a/drivers/media/platform/qcom/iris/iris_core.h b/drivers/media/platform/qcom/iris/iris_core.h
index b4a9469..3d82e71 100644
--- a/drivers/media/platform/qcom/iris/iris_core.h
+++ b/drivers/media/platform/qcom/iris/iris_core.h
@@ -121,6 +121,11 @@ struct iris_core {
 	struct completion			core_init_done;
 	u32					intr_status;
 	bool					hw_powered;
+	/* gaokun3 0064 (diagnostic): counters/flags, see iris_hfi_queue.c */
+	atomic_t				dbg_hard_irqs;
+	atomic_t				dbg_thread_irqs;
+	u32					dbg_pc_skips;
+	bool					dbg_hw_off_early;
 	struct delayed_work			sys_error_handler;
 	struct list_head			instances;
 	/* encoder and decoder have overlapping caps, so two different arrays are required */
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_common.c b/drivers/media/platform/qcom/iris/iris_hfi_common.c
index aff2793..9b584c5 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_common.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_common.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/ktime.h>
 #include <linux/pm_runtime.h>
 
 #include "iris_firmware.h"
@@ -92,6 +93,11 @@ int iris_hfi_core_init(struct iris_core *core)
 
 irqreturn_t iris_hfi_isr(int irq, void *data)
 {
+	struct iris_core *core = data;
+
+	if (core)
+		atomic_inc(&core->dbg_hard_irqs);
+
 	disable_irq_nosync(irq);
 
 	return IRQ_WAKE_THREAD;
@@ -120,6 +126,7 @@ irqreturn_t iris_hfi_isr_handler(int irq, void *data)
 		mutex_unlock(&core->lock);
 		goto out;
 	}
+	atomic_inc(&core->dbg_thread_irqs);
 	pm_runtime_mark_last_busy(core->dev);
 	iris_vpu_clear_interrupt(core);
 	mutex_unlock(&core->lock);
@@ -133,23 +140,72 @@ out:
 	return IRQ_HANDLED;
 }
 
+/*
+ * gaokun3 0064 (recover_skips): the body of iris_core_deinit() for a caller that
+ * already holds core->lock inside the runtime-suspend callback. The next open
+ * finds IRIS_CORE_DEINIT and cold-boots the firmware through iris_core_init().
+ */
+static void iris_dbg_recover_locked(struct iris_core *core)
+{
+	int ret;
+
+	dev_err(core->dev, "pcdbg: %u consecutive PC skips, no instance open: shutting the firmware down\n",
+		core->dbg_pc_skips);
+	iris_dbg_dump_locked(core, "before recover");
+	ret = iris_fw_unload(core);
+	iris_vpu_power_off(core);
+	iris_hfi_queues_deinit(core);
+	core->state = IRIS_CORE_DEINIT;
+	core->dbg_pc_skips = 0;
+	dev_err(core->dev, "pcdbg: firmware shut down (pas_shutdown=%d), next open cold-boots\n", ret);
+}
+
 int iris_hfi_pm_suspend(struct iris_core *core)
 {
+	ktime_t t0 = ktime_get();
 	int ret;
 
+	if (iris_pc_mode == 2) {
+		pm_runtime_mark_last_busy(core->dev);
+		return -EBUSY;
+	}
+
+	if (iris_pc_mode == 1 && !core->dbg_hw_off_early)
+		iris_vpu_power_off_hw_early(core);
+
 	ret = iris_vpu_prepare_pc(core);
 	if (ret) {
+		core->dbg_pc_skips++;
+		if (core->dbg_hw_off_early)
+			iris_vpu_power_on_hw_late(core);
+		if (iris_recover_skips && core->dbg_pc_skips >= iris_recover_skips) {
+			if (list_empty(&core->instances)) {
+				iris_dbg_recover_locked(core);
+				return 0;
+			}
+			dev_err(core->dev, "pcdbg: recover_skips reached but instances are open, not recovering\n");
+		}
 		pm_runtime_mark_last_busy(core->dev);
 		ret = -EAGAIN;
 		goto error;
 	}
+	core->dbg_pc_skips = 0;
 
 	ret = iris_set_hw_state(core, false);
-	if (ret)
+	if (iris_pcdbg)
+		dev_info(core->dev, "pcdbg: suspend: PC ready, set_remote_state(0)=%d, %lld us since entry\n",
+			 ret, ktime_us_delta(ktime_get(), t0));
+	if (ret) {
+		if (core->dbg_hw_off_early)
+			iris_vpu_power_on_hw_late(core);
 		goto error;
+	}
 
 	iris_vpu_power_off(core);
 
+	if (iris_pcdbg)
+		dev_info(core->dev, "pcdbg: suspend: powered off\n");
+
 	return 0;
 
 error:
@@ -161,6 +217,7 @@ error:
 int iris_hfi_pm_resume(struct iris_core *core)
 {
 	const struct iris_hfi_sys_ops *ops = core->hfi_sys_ops;
+	ktime_t t0 = ktime_get();
 	int ret;
 
 	ret = iris_vpu_power_on(core);
@@ -168,6 +225,8 @@ int iris_hfi_pm_resume(struct iris_core *core)
 		goto error;
 
 	ret = iris_set_hw_state(core, true);
+	if (iris_pcdbg)
+		dev_info(core->dev, "pcdbg: resume: set_remote_state(1)=%d\n", ret);
 	if (ret)
 		goto err_power_off;
 
@@ -183,6 +242,10 @@ int iris_hfi_pm_resume(struct iris_core *core)
 	if (ret)
 		goto err_suspend_hw;
 
+	if (iris_pcdbg)
+		dev_info(core->dev, "pcdbg: resume: warm boot ok, %lld us\n",
+			 ktime_us_delta(ktime_get(), t0));
+
 	return 0;
 
 err_suspend_hw:
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
index f00748b..c92a83e 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
@@ -3,6 +3,8 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/ktime.h>
+
 #include "iris_hfi_gen1.h"
 #include "iris_hfi_gen1_defines.h"
 #include "iris_instance.h"
@@ -53,6 +55,22 @@ static int iris_hfi_gen1_sys_image_version(struct iris_core *core)
 	return iris_hfi_queue_cmd_write_locked(core, &packet, packet.hdr.size);
 }
 
+/* gaokun3 0064 (fw_debug): venus pkt_sys_debug_config(), venus/hfi_cmds.c:38-50 */
+static int iris_hfi_gen1_sys_debug_config(struct iris_core *core, u32 mask)
+{
+	u32 buf[6];
+	struct hfi_sys_set_property_pkt *pkt = (struct hfi_sys_set_property_pkt *)buf;
+
+	pkt->hdr.size = sizeof(buf);
+	pkt->hdr.pkt_type = HFI_CMD_SYS_SET_PROPERTY;
+	pkt->num_properties = 1;
+	pkt->data[0] = 0x1;	/* HFI_PROPERTY_SYS_DEBUG_CONFIG, venus/hfi_helper.h:423 */
+	pkt->data[1] = mask;	/* struct hfi_debug_config.config, venus/hfi_helper.h:632-635 */
+	pkt->data[2] = 0x1;	/* .mode = HFI_DEBUG_MODE_QUEUE */
+
+	return iris_hfi_queue_cmd_write_locked(core, pkt, pkt->hdr.size);
+}
+
 static int iris_hfi_gen1_sys_interframe_powercollapse(struct iris_core *core)
 {
 	struct hfi_sys_set_property_pkt *pkt;
@@ -76,6 +94,10 @@ static int iris_hfi_gen1_sys_interframe_powercollapse(struct iris_core *core)
 	ret = iris_hfi_queue_cmd_write_locked(core, pkt, pkt->hdr.size);
 	kfree(pkt);
 
+	/* runs after SYS_INIT and after every warm boot: the debug config goes with it */
+	if (!ret && iris_fw_debug)
+		ret = iris_hfi_gen1_sys_debug_config(core, iris_fw_debug);
+
 	return ret;
 }
 
@@ -206,8 +228,10 @@ static int iris_hfi_gen1_session_stop(struct iris_inst *inst, u32 plane)
 				 * the firmware mostly never completes an HFI_FLUSH_OUTPUT sent
 				 * here, and then stops reading the command queue altogether.
 				 */
-				flush_type = inst->sub_state & (IRIS_INST_SUB_DRC |
-								IRIS_INST_SUB_DRC_LAST) ?
+				/* gaokun3 0064 (upstream_flush=Y): upstream FLUSH_OUTPUT, for A/B */
+				flush_type = (iris_upstream_flush ||
+					      inst->sub_state & (IRIS_INST_SUB_DRC |
+								 IRIS_INST_SUB_DRC_LAST)) ?
 					     HFI_FLUSH_OUTPUT : HFI_FLUSH_ALL;
 
 			reinit_completion(&inst->flush_completion);
@@ -219,8 +243,16 @@ static int iris_hfi_gen1_session_stop(struct iris_inst *inst, u32 plane)
 
 			ret = iris_hfi_queue_cmd_write(core, &flush_pkt, flush_pkt.shdr.hdr.size);
 			if (!ret) {
+				ktime_t t0 = ktime_get();
+
 				inst->flush_responses_pending++;
 				ret = iris_wait_for_session_response(inst, true);
+				if (iris_pcdbg)
+					dev_info(core->dev,
+						 "pcdbg: streamoff %s: flush type=%#x ret=%d after %lld us (sub_state=%#x)\n",
+						 V4L2_TYPE_IS_OUTPUT(plane) ? "OUTPUT" : "CAPTURE",
+						 flush_type, ret, ktime_us_delta(ktime_get(), t0),
+						 inst->sub_state);
 			}
 		} else if (inst->sub_state & IRIS_INST_SUB_LOAD_RESOURCES) {
 			reinit_completion(&inst->completion);
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
index bfd7495..09d029b 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
@@ -683,7 +683,10 @@ static void iris_hfi_gen1_flush_debug_queue(struct iris_core *core, u8 *packet)
 			struct hfi_msg_sys_debug_pkt *pkt =
 				(struct hfi_msg_sys_debug_pkt *)packet;
 
-			dev_dbg(core->dev, "%s", pkt->msg_data);
+			if (iris_fw_debug)
+				dev_info(core->dev, "pcdbg: fw: %.256s", pkt->msg_data);
+			else
+				dev_dbg(core->dev, "%s", pkt->msg_data);
 		}
 	}
 }
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_queue.c b/drivers/media/platform/qcom/iris/iris_hfi_queue.c
index bf6db23..dc92b67 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_queue.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_queue.c
@@ -3,11 +3,143 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/moduleparam.h>
 #include <linux/pm_runtime.h>
+#include <linux/slab.h>
 
 #include "iris_core.h"
 #include "iris_hfi_queue.h"
 #include "iris_vpu_common.h"
+#include "iris_vpu_register_defines.h"
+
+/* gaokun3 0064 (diagnostic): see iris_hfi_queue.h */
+bool iris_pcdbg = true;
+module_param_named(pcdbg, iris_pcdbg, bool, 0644);
+MODULE_PARM_DESC(pcdbg, "gaokun3 diag: log boot/suspend/resume/flush outcomes and dump state on PC skip or HFI timeout");
+bool iris_hfi_trace = true;
+module_param_named(hfi_trace, iris_hfi_trace, bool, 0644);
+MODULE_PARM_DESC(hfi_trace, "gaokun3 diag: log every HFI command written and every message read");
+bool iris_upstream_flush;
+module_param_named(upstream_flush, iris_upstream_flush, bool, 0644);
+MODULE_PARM_DESC(upstream_flush, "gaokun3 A/B: decoder CAPTURE streamoff while streaming sends HFI_FLUSH_OUTPUT as upstream does, instead of 0065's HFI_FLUSH_ALL (reproduces the #128 firmware wedge)");
+unsigned int iris_fw_debug;
+module_param_named(fw_debug, iris_fw_debug, uint, 0644);
+MODULE_PARM_DESC(fw_debug, "gaokun3 diag: if non-zero, send SYS_DEBUG_CONFIG(mode=queue, mask) after SYS_INIT and every resume, print fw log with dev_info (0x18 = error|fatal, 0x1c = +high)");
+bool iris_ahb_reset;
+module_param_named(ahb_reset, iris_ahb_reset, bool, 0644);
+MODULE_PARM_DESC(ahb_reset, "gaokun3 A/B: reset the CPU-VPU AHB bridge before switching vcodec0 to HW mode (upstream 9dc5f705)");
+bool iris_preset_mask;
+module_param_named(preset_mask, iris_preset_mask, bool, 0644);
+MODULE_PARM_DESC(preset_mask, "gaokun3 A/B: 0xb0088 read-modify-write clearing bits 0 and 4 only (venus sm8350_reg_preset) instead of writing 0");
+bool iris_no_arg3;
+module_param_named(no_arg3, iris_no_arg3, bool, 0644);
+MODULE_PARM_DESC(no_arg3, "gaokun3 A/B: do not write CPU_CS_SCIACMDARG3=1 at firmware boot (venus V6 / msm_vidc never do)");
+bool iris_bus_reset_only;
+module_param_named(bus_reset_only, iris_bus_reset_only, bool, 0644);
+MODULE_PARM_DESC(bus_reset_only, "gaokun3 A/B: pulse only the 'bus' reset (GCC_VIDEO_AXI0_CLK_ARES) at power-on, like venus and msm_vidc");
+bool iris_db_rx_req;
+module_param_named(db_rx_req, iris_db_rx_req, bool, 0644);
+MODULE_PARM_DESC(db_rx_req, "gaokun3 A/B: ring the doorbell only when the firmware set cmdq rx_req (venus/msm_vidc semantics)");
+unsigned int iris_pc_mode;
+module_param_named(pc_mode, iris_pc_mode, uint, 0644);
+MODULE_PARM_DESC(pc_mode, "gaokun3 A/B: 0 upstream; 1 venus order (vcodec0 SW mode, clock off, GDSC off) before PC_PREP; 2 refuse runtime suspend (-EBUSY)");
+unsigned int iris_recover_skips;
+module_param_named(recover_skips, iris_recover_skips, uint, 0644);
+MODULE_PARM_DESC(recover_skips, "gaokun3 mitigation: after N consecutive PC skips with no open instance, shut the firmware down (pas_shutdown) so the next open cold-boots it; 0 = off");
+bool iris_read_core_pwr;
+module_param_named(read_core_pwr, iris_read_core_pwr, bool, 0644);
+MODULE_PARM_DESC(read_core_pwr, "gaokun3 diag: include WRAPPER_CORE_POWER_STATUS (0xb0080, wrapper block) in state dumps");
+
+static void iris_dbg_qhdr(struct iris_core *core, const char *name,
+			  struct iris_iface_q_info *q)
+{
+	struct iris_hfi_queue_header *h = q->qhdr;
+
+	if (!h) {
+		dev_info(core->dev, "pcdbg:   %s: no header\n", name);
+		return;
+	}
+
+	dev_info(core->dev, "pcdbg:   %s: rd=%u wr=%u rx_req=%u tx_req=%u status=%#x\n",
+		 name, h->read_idx, h->write_idx, h->rx_req, h->tx_req, h->status);
+}
+
+/*
+ * Caller holds core->lock. Queue headers and SFR are DDR. Registers are read only
+ * while hw_powered, and only from blocks the driver already reads on this path
+ * (CPU_CS 0xa0000, wrapper 0xb0000, TZ wrapper 0xc0000). Never the vcodec block.
+ */
+void iris_dbg_dump_locked(struct iris_core *core, const char *why)
+{
+	u32 *sfr = core->sfr_vaddr;
+
+	if (!iris_pcdbg)
+		return;
+
+	dev_info(core->dev,
+		 "pcdbg: dump (%s): core_state=%d hw_powered=%d irqs hard=%d thread=%d intr_status=%#x pc_skips=%u\n",
+		 why, core->state, core->hw_powered,
+		 atomic_read(&core->dbg_hard_irqs), atomic_read(&core->dbg_thread_irqs),
+		 core->intr_status, core->dbg_pc_skips);
+
+	if (core->iface_q_table_vaddr) {
+		iris_dbg_qhdr(core, "cmdq", &core->command_queue);
+		iris_dbg_qhdr(core, "msgq", &core->message_queue);
+		iris_dbg_qhdr(core, "dbgq", &core->debug_queue);
+	}
+
+	/* SFR: u32 buffer size, then text written by the firmware on a fatal error */
+	if (sfr && sfr[1])
+		dev_info(core->dev, "pcdbg:   sfr: %.200s\n", (char *)&sfr[1]);
+
+	if (!core->hw_powered)
+		return;
+
+	dev_info(core->dev,
+		 "pcdbg:   ctrl_status=%#x arg3=%#x tz_cpu_status=%#x intr_status=%#x intr_mask=%#x clk_cfg=%#x\n",
+		 readl(core->reg_base + CPU_CS_BASE_OFFS + 0x4c),
+		 readl(core->reg_base + CPU_CS_BASE_OFFS + 0x58),
+		 readl(core->reg_base + WRAPPER_TZ_CPU_STATUS),
+		 readl(core->reg_base + WRAPPER_INTR_STATUS),
+		 readl(core->reg_base + WRAPPER_INTR_MASK),
+		 readl(core->reg_base + WRAPPER_CORE_CLOCK_CONFIG));
+
+	if (iris_read_core_pwr)
+		dev_info(core->dev, "pcdbg:   core_power_status=%#x\n",
+			 readl(core->reg_base + WRAPPER_CORE_POWER_STATUS));
+}
+
+void iris_dbg_dump(struct iris_core *core, const char *why)
+{
+	mutex_lock(&core->lock);
+	iris_dbg_dump_locked(core, why);
+	mutex_unlock(&core->lock);
+}
+
+/* Must not be called with core->lock held (iris_hfi_queue_dbg_read() takes it). */
+void iris_dbg_drain_dbgq(struct iris_core *core, const char *why)
+{
+	u32 *w;
+	int n = 0;
+
+	if (!iris_pcdbg)
+		return;
+
+	w = kzalloc(IFACEQ_CORE_PKT_SIZE, GFP_KERNEL);
+	if (!w)
+		return;
+
+	/* hfi_msg_sys_debug_pkt: size, type, msg_type, msg_size, ts_hi, ts_lo, msg_data[] */
+	while (n < 64 && !iris_hfi_queue_dbg_read(core, w)) {
+		if (w[0] > 24 && w[0] <= IFACEQ_CORE_PKT_SIZE)
+			dev_info(core->dev, "pcdbg: fw (%s): %.*s\n", why,
+				 (int)min_t(u32, w[0] - 24, 256), (char *)&w[6]);
+		n++;
+	}
+	dev_info(core->dev, "pcdbg: drained %d debug-queue packets (%s)\n", n, why);
+
+	kfree(w);
+}
 
 static int iris_hfi_queue_write(struct iris_iface_q_info *qinfo, void *packet, u32 packet_size)
