# 音频/蓝牙死锁取证看门狗（见 bin/gaokun3-hangdump.sh 与 findings #38）。
# 开机完成后才起，避免和启动期的正常 D 状态混淆。
service hangdump /vendor/bin/gaokun3-hangdump.sh
    user root
    group root
    # ⚠️ 这里【曾经】是 `seclabel u:r:shell:s0` —— 让一个 root 守护进程跑在
    #    为 adb 设计的 shell 域里，方向是反的，转 enforcing 也过不了。
    #    现在由 sepolicy/file_contexts 给可执行文件打标签，init 自动做域转换
    #    （sepolicy/gaokun3_scripts.te）。
    disabled

on property:sys.boot_completed=1
    mkdir /data/vendor/gaokun3 0770 root system
    # ★ 2026-09-29：.done 标记在 /data 上会跨重启保留 —— 原先没人删，第一次取证之后看门狗
    #   就永久不跑了（与"每次启动一份"的设计相反）。vendor_init 对 vendor_data_file 有 unlink。
    rm /data/vendor/gaokun3/hangdump.done
    start hangdump
