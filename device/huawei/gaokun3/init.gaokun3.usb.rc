# init.gaokun3.usb.rc -- USB gadget for Huawei MateBook E Go
#
# 分工（依据 AOSP 16 源码，不是猜的）：
#   system/core/rootdir/init.rc              已挂 configfs 到 /config
#   system/etc/init/hw/init.usb.configfs.rc  属性触发：adbd 起、ffs.ready 后写 UDC
#   本文件                                    gadget 骨架 + ffs 挂载 + 角色 + configfs=1
#
# 实测教训（docs/stage2-findings.md 第 8.3quinquies 节）：
# ① 骨架（尤其 mkdir functions/ffs.adb 注册实例）必须在 functionfs mount
#    之前，否则 mount 报 ENODEV —— 全部放 post-fs-data 按序执行。
# ② UCSI（EC 内建后）会把 otg 口切成 host，xhci 一起来 gadget 就没戏。
#    必须写 /sys/class/usb_role/.../role = device（接口名 Ubuntu 实测）——
#    现在由 gaokun3-usbrole.sh device 来写，port0 上有下游设备时它保持 host。
# ③ ro.serialno 本构建未设置，write 展开会失败，用字面量。

on post-fs-data
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE7
    write /config/usb_gadget/g1/bcdDevice 0x0100
    write /config/usb_gadget/g1/bcdUSB 0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber gaokun3
    write /config/usb_gadget/g1/strings/0x409/manufacturer HUAWEI
    write /config/usb_gadget/g1/strings/0x409/product MateBookEGo
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000,no_disconnect=1
    # 切 device 交给 gaokun3_role_device（etc/usbrole.rc）：port0 上插着 U 盘 / 鼠标这类设备、
    # xhci 已枚举到它们时保持 host，否则照旧切 device（v1.0 PWR-5 / STOR-2）。
    # 用 exec_start（同步，etc/bpfrelabel.rc 用过同一招）而不是 start：下面 configfs=1 → adbd →
    # 写 UDC 要等 device 角色就位。原先的 write 写完就返回（dwc3 的切换本身是异步的），脚本则轮询到
    # UDC 出现才退出，顺序只会更稳。代价：切不成（口坏）时 init 在这里最多等约 6 秒。
    # ⚠️ 保持 host 的那种开机，init.usb.configfs.rc 写 UDC 会落空（UDC 不在）⇒ 之后换插 PC、follow 切回
    #    device 时 USB adb 能不能自己回来，取决于 gadget 有没有挂上 —— 未实测（见 v1.0 计划 PWR-5 验收）。
    exec_start gaokun3_role_device
    # configfs=1 必须在 post-fs-data 就设好：system 的 init.usb.rc:109 在 boot
    # 触发时就会把 config 设成 adb，届时 configfs 若还是 0 就走 legacy 死路。
    setprop sys.usb.configfs 1

on boot
    exec_start gaokun3_role_device
    # ★ B1（2026-10-04）：这里原先无条件 setprop sys.usb.config adb —— 开机必开 adb，
    #   用户在开发者选项里关掉「USB 调试」，重启又回来了。现在交给 system 的
    #   init.usb.rc:109-110（refs/lineage-system-core/rootdir/）：
    #       on boot && property:persist.sys.usb.config=*
    #           setprop sys.usb.config ${persist.sys.usb.config}
    #   （`=*` 要求属性非空，init/action.cpp:199-205）。
    #   · 开发构建：system_ext 的 ro.debuggable=1 让 refs/aosp-build/tools/post_process_props.py:33-42 往同一个
    #     build.prop 补了 persist.sys.usb.config=adb ⇒ 照旧开机即开（实机那份 build.prop 里就有）。
    #   · 发布构建：没人设它 ⇒ 开机不起 adbd，USB 侧只充电。
    #   · 开发机跑发布构建：先 setprop persist.sys.usb.config adb 持久化进 /data。
    #   当初强写，推测是因为 Stage 2 那时 system_ext 还没有 ro.debuggable=1、也就没有这个 persist 值。

# 发布构建里用户在开发者选项打开「USB 调试」/「无线调试」：AdbService 只负责起 adbd，
# 把 adb 写进 sys.usb.config 的是 UsbDeviceManager —— 本机没有它（只在
# /sys/class/android_usb 存在时才建，主线内核没有这个类，见 device.mk 的 usb.host 一段）。
# 于是 adbd 起来了、gadget 却永远不绑 UDC。这里补上：adbd 一跑起来就把 config 落成 adb，
# 交给 init.usb.configfs.rc 的 ffs.ready 触发器去绑 UDC。
#   · 只在会话内有效：重启后 AdbService 按 persist.sys.usb.config（发布构建为空）把开关复位成关。
#   · 开发构建里 config 本来就是 adb：同值 setprop 照样触发（property_service.cpp:434 无条件
#     NotifyPropertyChange），再走一遍绑定动作 —— 与 adb root 重启 adbd 时那一遍相同，
#     symlink 已存在 / UDC 已绑定只会各报一条错，不断连（UDC 那半句待上机核实）。
# ⚠️ "AdbService 只 ctl.start adbd、不碰 sys.usb.config"与"重启后按 persist 复位"是按 frameworks/base 写的，本地 refs
#   没有那棵树，待构建机核实（services/core/java/com/android/server/adb/AdbService.java）。
on property:init.svc.adbd=running && property:sys.usb.configfs=1
    setprop sys.usb.config adb
