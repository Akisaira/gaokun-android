# hexagonrpcd —— 给 SLPI 上的 DSP 当只读文件服务器（传感器整条链的地基）。
#
# ⚠️ 全 AOSP 树里【没有任何现成的 sepolicy】（grep 过 system/sepolicy 与所有
#    device/*/*/sepolicy，零命中）。它是 external/hexagonrpc 的上游二进制，
#    而那个上游从来没在带 SELinux 的 Android 上被 enforcing 跑过。
#
# 此前它没有 file_contexts 条目，于是留在 init 域里 —— #60 普查里
# `u:r:init:s0` 那 88 条中的 22 条就是它。
#
# 安装路径从构建产物核实：out/target/product/gaokun3/vendor/bin/hexagonrpcd
type hexagonrpcd, domain;
type hexagonrpcd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hexagonrpcd)

# ⓘ 2026-09-29 更新：/dev/fastrpc-sdsp 已由 file_contexts 标成 gaokun3_fastrpc_device，
#    规则就在下面（第 4 步已完成）。

# ── 第 4 步：换上带域的镜像之后重新普查，照实机拒绝写的规则 ──────────────
# 证据：2026-08-23 slot_a（构建戳 1787436126）开机后的 avc 日志，
#       scontext 这次是真实主体 u:r:hexagonrpcd:s0。

# 跟 SLPI 上的 DSP 说话。这是传感器整条链的地基。
allow hexagonrpcd gaokun3_fastrpc_device:chr_file rw_file_perms;

# 读 /sys/firmware/devicetree/base/compatible —— 它用机型串去挑 DSP 侧的配置。
# ⚠️ 只给读。写 sysfs 它不需要。
allow hexagonrpcd sysfs:file r_file_perms;
