# WiFi HAL（android.hardware.wifi-service，legacy HAL 跑 ath11k）。2026-09-27，#126。

# 证据：`hal_wifi_default self:netlink_route_socket { create bind }`（uptime 15.2 s，
# 早于开机完成时才施加的审计限速，所以其它权限没被拒就是真的没被拒）。
allow hal_wifi_default self:netlink_route_socket { create bind };
# ⓘ A17 起策略打开了 policycap netlink_xperm（system/sepolicy/private/policy_capabilities:26；A16 的 crDroid 16.0
#   f2ea821 只有 functionfs_seclabel，没有它）。7.2 内核见到它就不再查 nlmsg_read / nlmsg_write，改成对每条
#   NETLINK_ROUTE 消息查 `nlmsg` 权限 + nlmsg 扩展权限（security/selinux/nlmsgtab.c:187-190、hooks.c:6404-6406）。
#   这个域本来就没有任何 nlmsg_* 权限（只建 socket、bind 收 multicast 事件，接收不过 nlmsg 检查），A16 / A17 行为一样。
#   ⚠️ 哪天它真要发 RTM_* 消息，要写的是
#     allow hal_wifi_default self:netlink_route_socket nlmsg;
#     allowxperm hal_wifi_default self:netlink_route_socket nlmsg { RTM_… };
#   而不是 nlmsg_read / nlmsg_write（宏见 public/nlmsg_macros）。
#   ⚠️ 别照抄 private/hal_wifi_hostapd.te:24-25：那里写的是 `nlmsg_write` + allowxperm，基础的 `nlmsg` 权限是
#     hostapd 经 net_domain()（vendor/hal_wifi_hostapd_default.te:7）从 private/net.te:35 拿到的；
#     hal_wifi_default 不是 netdomain，只写 allowxperm 不写 `allow … nlmsg` 照样被拒。

# HAL 启动时 setprop vendor.wlan.firmware.version / vendor.wlan.driver.version。
# 证据：`hal_wifi_default vendor_default_prop:property_service set  property=vendor.wlan.firmware.version`。
# 不能直接放行：vendor_default_prop 只许 init / vendor_init 设（private/domain.te:802 的 neverallow；A17 在 :854）。
# ★ 照搬 cuttlefish / goldfish 的做法（device/google/cuttlefish/shared/sepolicy/vendor/
#   property.te:4 与 property_contexts:9-10）：给这两个属性一个专用类型。
vendor_restricted_prop(vendor_wlan_versions_prop)
set_prop(hal_wifi_default, vendor_wlan_versions_prop)
