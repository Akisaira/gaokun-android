<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      TCP 缓冲区：rmem 上限 2 MB → 8 MB，wmem 上限 1 MB → 4 MB（其余照 AOSP 默认）。
      默认值出自 packages/modules/Wifi/service/ServiceWifiResources/res/values/config.xml:453，
      由 ClientModeImpl.java:8386 下发给 netd（写 /proc/sys/net/ipv4/tcp_rmem / tcp_wmem）。

      ★ 实测（2026-09-24，docs/stage4-findings.md #119）：到 Cloudflare 边缘 RTT 约 294 ms，
        单连接吞吐 ≈ 窗口 / RTT —— 2 MB 上限时 3.5–3.8 MB/s，临时改成 8 MB 后 9.1–9.8 MB/s
        （同一 URL、同一时刻，各两次）。4 连接并发合计 12.6 MB/s ⇒ 出口本身不是瓶颈。
        系统内 OTA 是单连接下载，这条直接决定它有多快（v0.6.2 发版说明里的"下载只有 1–2 MB/s"）。
      内存代价：只在确有长肥管道时 autotuning 才会涨到上限，局域网 / 低 RTT 连接不受影响。
    -->
    <string name="config_wifi_tcp_buffers" translatable="false">524288,1048576,8388608,262144,524288,4194304</string>

    <!--
      关掉 WPA2 → WPA3 自动升级（issue #11 附带报告）：WPA2/WPA3 混合模式的路由器上，框架默认把保存的
      WPA2 网络升级成 SAE 去连，ath11k 在 SAE 关联时被 AP 拒（Reason 9 = STA_REQ_ASSOC_WITHOUT_AUTH），
      纯 WPA2 正常；报告者用 force-overlay-config-value 关掉它后能连上。默认值 true 出自
      packages/modules/Wifi/service/ServiceWifiResources/res/values/config.xml:808，读取在 WifiGlobals.java:352。
      只影响"混合模式 AP 上的 WPA2 网络要不要改走 SAE"；纯 WPA3 网络照旧走 SAE。
      与 issue #2（纯 WPA3 关联后被踢，TODO A6b）不是一回事，那条仍未复现。
    -->
    <bool name="config_wifiSaeUpgradeEnabled" translatable="false">false</bool>

    <!--
      软件 PNO（v1.0 计划 NET-1）：息屏且系统醒着时（插电、后台下载 / 播放持锁），Wi-Fi 一断就再也连不回来，
      直到亮屏。2026-10-04 实机 dumpsys wifi：断开后 6 次 "PnoScanListener onFailure: reason: -3 not supported"，
      之后 WifiConnectivityManager 放弃（"Failed to successfully start PNO scan for 5 times"），已保存的网络
      -34 dBm 就在旁边也不连。根因：ath11k 没有 sched_scan（iw phy 里没有 start_sched_scan），硬件 PNO 不可用；
      而软件 PNO（定时单次扫描代替固件 PNO）默认关着。
      ⚠️ 不要动 config_wifi_background_scan_support —— 那是硬件 PNO 的开关，ath11k 开了也只会在 wificond 里失败。

      依据（2026-10-04 从本机 apex 里取出的 ServiceWifiResources.apk / service-wifi.jar 反汇编，源码行号待构建机核实）：
        * 资源在 overlayable "WifiCustomization" 里、policy 含 vendor，id 0x7f02006c，默认 false（dumpsys 的 WifiResourceCache 同）；
        * 唯一读取点 WifiGlobals.isSwPnoEnabled()，用在两处：
          WifiScanningServiceImpl$WifiPnoScanStateMachine$StartedState.processMessage —— 硬件 PNO 不支持时，
            isSwPnoEnabled() && DeviceConfigFacade.isSoftwarePnoEnabled() 才转进 SwPnoScanState，否则回 -3 "not supported"；
          WifiServiceImpl.isPnoSupported() —— 对外报告"支持 PNO"。
      ⚠️★ 所以光改这里还不够：还有第二道门 DeviceConfig wifi/software_pno_enabled（DeviceConfigFacade
         .updateDeviceConfigFlags 里默认 false），本机上它被显式置成了 false（device_config list wifi，
         wifi 命名空间 94 项，多半是 GMS 同步下来的，来源未核实）。那一道要另想办法（docs/v1.0-plan.md 的 NET-1）。
    -->
    <bool name="config_wifiSwPnoEnabled" translatable="false">true</bool>

    <!--
      MAC 地址（v1.0 NET-4 / D14：持久模式 + 稳定的设备 MAC）。资源出处：packages/modules/Wifi/service/
      ServiceWifiResources/res/values/config.xml，均在 overlayable.xml 的 "WifiCustomization"（:18-20，policy 含 vendor）里。

      ① 随机化总开关，默认 false（config.xml:373；overlayable.xml:129）。WifiGlobals.isConnectedMacRandomizationEnabled
         （WifiGlobals.java:258-261）只看它；它为 false 时 ClientModeImpl 连接前根本不碰 MAC（:8345-8360），
         每个网络上的"隐私"设置一律无效、Settings 也不显示（WifiConfigController2.java:341），wlan0 用的就是固件每次开机
         随机给的 00:03:7f:12:xx:xx —— B20"每次开机都换"的真正原因。打开后改 MAC 走 HAL 的 setMacAddress
         （iface down → SIOCSIFHWADDR → up，hardware/interfaces/wifi/aidl/default/wifi_iface_util.cpp:53-80）。
         2026-10-04 用 force-overlay-config-value 在本机临时打开过，三次都连上（TODO B20 / #14 那一行）。
         新网络默认"按网络固定的随机 MAC"靠 tree-fix [20]（crDroid 把默认写死成每次连接都换，没有资源能改）。
      ② config_wifiSaveFactoryMacToWifiConfigStore 默认 true（config.xml:370；overlayable.xml:128）：框架把第一次拿到的
         出厂 MAC 永久存进 WifiSettingsConfigStore（ClientModeImpl.java:8065-8095）。老机器存的是当年那个固件随机地址，
         tree-fix [19] 从 soc0 序列号派生的稳定地址就永远用不上 ⇒ 关掉，每次都问 HAL（HAL 那边本来就稳定）。
      ⬜ 未编译、未上机。判据见 scripts/crdroid-tree-fixes.py 的 [19] / [20]。
    -->
    <bool name="config_wifi_connected_mac_randomization_supported" translatable="false">true</bool>
    <bool name="config_wifiSaveFactoryMacToWifiConfigStore" translatable="false">false</bool>
</resources>
