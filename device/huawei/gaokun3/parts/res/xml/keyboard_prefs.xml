<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreferenceCompat
        android:key="keyboard_enabled"
        android:title="@string/keyboard_switch_title"
        android:summaryOn="@string/keyboard_switch_summary_on"
        android:summaryOff="@string/keyboard_switch_summary_off"
        android:defaultValue="true" />
    <com.android.settingslib.widget.FooterPreference
        android:key="keyboard_note"
        android:title="@string/keyboard_note"
        android:selectable="false" />
</PreferenceScreen>
