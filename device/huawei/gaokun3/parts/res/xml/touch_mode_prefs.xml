<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- defaultValue 只影响 SharedPreferences；真值由 TouchModeSettingsActivity 从
         persist.sys.gaokun3.touch_mode 读回来。写 true 是为了与镜像默认值（game）一致。 -->
    <SwitchPreferenceCompat
        android:key="touch_game_mode"
        android:title="@string/touch_mode_switch_title"
        android:summaryOn="@string/touch_mode_switch_summary_on"
        android:summaryOff="@string/touch_mode_switch_summary_off"
        android:defaultValue="true" />
    <com.android.settingslib.widget.FooterPreference
        android:key="touch_mode_note"
        android:title="@string/touch_mode_note"
        android:selectable="false" />
</PreferenceScreen>
