<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- defaultValue 只影响 SharedPreferences；真值由 StandbySettingsActivity 从
         persist.vendor.gaokun3.allow_suspend 读回来。写 true 是为了与镜像默认值（1）一致。 -->
    <SwitchPreferenceCompat
        android:key="standby_enabled"
        android:title="@string/standby_switch_title"
        android:summaryOn="@string/standby_switch_summary_on"
        android:summaryOff="@string/standby_switch_summary_off"
        android:defaultValue="true" />
    <com.android.settingslib.widget.FooterPreference
        android:key="standby_note"
        android:title="@string/standby_note"
        android:selectable="false" />
</PreferenceScreen>
