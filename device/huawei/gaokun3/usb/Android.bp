//
// USB 端口 HAL（android.hardware.usb IUsb V3）。
//
// 向框架（UsbPortManager）报告 port0 的状态，并按插进来的东西决定 port0 的数据角色 ——
// 也就是原先 gaokun3-usbrole.sh 的 follow 模式，从每 2 秒轮询一次改成由 uevent 驱动。
// 说明在 Usb.cpp 与 Follow.h 的开头。
//
cc_binary {
    name: "android.hardware.usb-service.gaokun3",
    relative_install_path: "hw",
    vendor: true,

    srcs: [
        "Follow.cpp",
        "Port.cpp",
        "Usb.cpp",
    ],

    init_rc: ["android.hardware.usb-service.gaokun3.rc"],
    vintf_fragment_modules: ["android.hardware.usb-service.gaokun3.xml"],

    stl: "c++_static",
    shared_libs: [
        "libbinder_ndk",
        "liblog",
    ],
    static_libs: [
        // 版本与清单片段一致：V3（框架兼容性矩阵 compatibility_matrix.202504.xml 写的是 1-3）。
        "android.hardware.usb-V3-ndk",
    ],
    cflags: ["-Wall", "-Werror"],
}

vintf_fragment {
    name: "android.hardware.usb-service.gaokun3.xml",
    src: "android.hardware.usb-service.gaokun3.xml",
    vendor: true,
}
