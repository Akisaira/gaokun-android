# boot_control HAL. class early_hal so it is up before update_engine and
# before update_verifier runs at the end of a slot switch.
service vendor.boot-gaokun3 /vendor/bin/hw/android.hardware.boot-service.gaokun3
    class early_hal
    user root
    group root

# ★ 统一启动入口（2026-10-05，S9；docs/boot-entry-design.md §4.6.1）：开机完成时让 HAL 的线程干活
#   （Gk3Boot.cpp：bless 入口条目、清 GK3 boot_streak、导出 vendor.gaokun3.bootentry.*、部署 / 撤掉入口）。
#   HAL 不直接读 sys.boot_completed（boot_status_prop），由这里转成我们自己的 vendor 属性：
#   vendor_init 读得到 boot_status_prop（refs/lineage-sepolicy/private/vendor_init.te:316），
#   设得了 vendor_gaokun3_prop（sepolicy/vendor_gaokun3_props.te 的 set_prop(vendor_init, …)）。
on property:sys.boot_completed=1
    setprop vendor.gaokun3.boot.done 1
