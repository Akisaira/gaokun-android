# gaokun3 只有 WiFi：开机自己连上网，否则救援系统就是一台连不上的机器。
# 逻辑在 /usr/lib/gaokun3/gk3-wifi（注释也在那边）。
#
# ⚠️ 不写 Requires=/BindsTo= 之类的硬依赖：Alpine 版吃过一次亏 —— OpenRC 的 `need`
#    指向一个不在 runlevel 里的服务，本服务就静默不启动，症状是"起来了但既没网也没 ssh"。
#    这里只做排序（After=）。
[Unit]
Description=gaokun3 WiFi (wpa_supplicant + dhcpcd)
After=systemd-udevd.service local-fs.target
Before=ssh.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/gaokun3/gk3-wifi
ExecStop=-/bin/sh -c 'dhcpcd -k wlan0; kill $(cat /run/wpa_supplicant.pid 2>/dev/null) 2>/dev/null; true'

[Install]
WantedBy=multi-user.target
